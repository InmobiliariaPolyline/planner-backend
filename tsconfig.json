{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  // El cliente Prisma generado NO se compila con tsc (downlevelearlo rompe su
  // runtime: "Must call super constructor"). Se copia tal cual a dist/ en el
  // paso de build de package.json.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
