// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String   @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  budget         Float
  /// Se calcula del rango de fechas (no es entrada del usuario)
  durationMonths Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Se calcula como el promedio del progreso de las tareas (0 si no hay)
  progress Int
  /// Campos heredados sin uso a nivel de proyecto; el backend siempre escribe
  /// '' y false. Se conservan para no acoplar el deploy a una migración.
  dependency String  @default("")
  isPhase    Boolean @default(false)
  ownerName  String

  // Relaciones
  tasks       Task[]
  milestones  Milestone[]
  teamMembers TeamMember[]
  shareLinks  ShareLink[]
}

/// Enlace público para acceder a un expediente sin iniciar sesión.
/// El token se rota (regenera) cuantas veces se quiera; no caduca.
/// Al borrar el expediente se borran sus enlaces (onDelete: Cascade).
model ShareLink {
  id        String   @id @default(uuid())
  token     String   @unique
  role      String   @default("viewer") // "viewer" | "editor"
  label     String? // nombre opcional para distinguir enlaces
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalAreaId String
  technicalArea   TechnicalArea @relation(fields: [technicalAreaId], references: [id])
  progress        Int
  dependency      String
  isPhase         Boolean
  ownerName       String

  // Relaciones
  performanceMetrics PerformanceMetric[]
  driveLinks         DriveLink[]
}

model Milestone {
  id          String   @id @default(uuid())
  description String
  date        DateTime
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PerformanceMetric {
  id         String   @id @default(uuid())
  unit       String
  ratePerDay Float
  divisor    Int
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DriveLink {
  id        String   @id @default(uuid())
  url       String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id           String     @id @default(uuid())
  name         String
  teamStatusId String
  teamStatus   TeamStatus @relation(fields: [teamStatusId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TeamStatus {
  id        String   @id @default(uuid())
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  teamMembers TeamMember[]
}

model TechnicalArea {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tasks Task[]
}
