// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cuenta con la que se entra al sistema. Hoy hay dos roles: "admin"
/// (Administrador) y "architect" (Arquitecto). El Administrador ve todos los
/// expedientes; el Arquitecto sólo los que creó o donde está vinculado como
/// participante del equipo.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Correo vinculado para la verificación en dos pasos (opcional). Si está
  /// vinculado, el login pide además un código de 6 dígitos enviado ahí.
  twoFactorEmail   String?
  twoFactorEnabled Boolean @default(false)

  createdProjects Project[]       @relation("ProjectCreator")
  teamMemberships TeamMember[]
  twoFactorCodes  TwoFactorCode[]
}

/// Código de un solo uso para vincular/desvincular el correo de verificación
/// en dos pasos, o para completar un inicio de sesión con esa verificación
/// activada. Se borra al usarse o al caducar (10 min); reenviar antes de 2
/// min no está permitido (ver src/lib/twoFactor.ts).
model TwoFactorCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "link" (vincular) | "unlink" (quitar) | "login" (segundo paso al entrar)
  purpose   String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

model Project {
  id             String   @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  budget         Float
  /// Se calcula del rango de fechas (no es entrada del usuario)
  durationMonths Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Se calcula como el promedio del progreso de las tareas (0 si no hay)
  progress Int
  /// Campos heredados sin uso a nivel de proyecto; el backend siempre escribe
  /// '' y false. Se conservan para no acoplar el deploy a una migración.
  dependency String  @default("")
  isPhase    Boolean @default(false)
  ownerName  String

  /// Quién creó el expediente (cuenta real). Nulo en expedientes creados antes
  /// de existir el login; el Administrador los ve igual, un Arquitecto no.
  createdById String?
  createdBy   User?   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Logotipo del expediente: data URI (imagen + base64), 150×150 a 250×250 px.
  /// Opcional y editable en cualquier momento.
  logoUrl String?

  // Relaciones
  tasks          Task[]
  milestones     Milestone[]
  teamMembers    TeamMember[]
  shareLinks     ShareLink[]
  activityEvents ActivityEvent[]

  @@index([createdById])
}

/// Historial de sucesos de un expediente: creación, cambios de valor, borrados…
/// Se escribe desde la API tras cada operación de escritura y se borra en
/// cascada con el expediente. `actor` hoy es "Administrador" o
/// "Colaborador (enlace)"; queda listo para un usuario real más adelante.
model ActivityEvent {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  actor     String
  /// Código de acción: "project.create", "task.update", "member.remove", …
  action    String
  /// Entidad afectada, en texto: "expediente", "tarea", "participante", …
  entity    String
  /// Nombre de lo afectado (título de la tarea, del participante…), si aplica.
  target    String?
  /// Frase legible del suceso.
  summary   String
  /// Tono para la interfaz: "neutral" | "positive" | "negative" | "warning".
  tone      String   @default("neutral")
  /// Cambios de valor en ediciones: [{ field, label, from, to }].
  changes   Json?

  @@index([projectId, createdAt])
}

/// Enlace público para acceder a un expediente sin iniciar sesión.
/// El token se rota (regenera) cuantas veces se quiera; no caduca.
/// Al borrar el expediente se borran sus enlaces (onDelete: Cascade).
model ShareLink {
  id        String   @id @default(uuid())
  token     String   @unique
  role      String   @default("viewer") // "viewer" | "editor"
  label     String? // nombre opcional para distinguir enlaces
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalAreaId String
  technicalArea   TechnicalArea @relation(fields: [technicalAreaId], references: [id])
  progress        Int
  /// Si es true, `progress` se recalcula solo según cuánto tiempo pasó entre
  /// startDate y endDate. Se apaga (pasa a false) en cuanto alguien ajusta el
  /// avance a mano; a partir de ahí el valor queda fijo hasta que se toque de
  /// nuevo manualmente.
  autoProgress    Boolean       @default(true)
  dependency      String
  isPhase         Boolean
  ownerName       String

  // Relaciones
  taskMaterials TaskMaterial[]
  driveLinks    DriveLink[]
}

model Milestone {
  id          String   @id @default(uuid())
  description String
  date        DateTime
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Catálogo de materiales de referencia (densidad y métrica de cómputo),
/// cargado una vez desde una lista preparada por el usuario (ver
/// prisma/seed-materials.ts). Cada material —no solo su categoría— tiene sus
/// propios valores, por lo que dos materiales de la misma categoría pueden
/// diferir entre sí.
model Material {
  id          String   @id @default(uuid())
  /// Ej. "Concreto", "Acero y hierro", "Madera"…
  category    String
  /// Nombre exacto del material dentro de su categoría.
  name        String
  /// Densidad de referencia en kg/m³ (o el valor equivalente indicado en la
  /// ficha original cuando el material se cotiza por otra vía, p. ej. g/m²).
  density     Float
  /// Métrica(s) de cómputo que aplica, tal como viene en la lista de
  /// referencia (texto libre: "Volumen (m³)", "Peso (kg / ton)", etc.).
  metricLabel String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskMaterials TaskMaterial[]

  @@unique([category, name])
  @@index([category])
}

/// Selección de un material para una tarea concreta, con la cantidad que se
/// va a usar. Cada fila es independiente: si se eligen dos materiales de la
/// misma categoría, cada uno conserva su propia densidad/métrica y su propia
/// cantidad, nunca se combinan.
model TaskMaterial {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([taskId])
  @@index([materialId])
}

model DriveLink {
  id        String   @id @default(uuid())
  url       String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id           String     @id @default(uuid())
  name         String
  teamStatusId String
  teamStatus   TeamStatus @relation(fields: [teamStatusId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Vincula el participante con una cuenta real del sistema (opcional): así
  /// un Arquitecto puede ver el expediente aunque no lo haya creado él.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model TeamStatus {
  id        String   @id @default(uuid())
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  teamMembers TeamMember[]
}

model TechnicalArea {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tasks Task[]
}
